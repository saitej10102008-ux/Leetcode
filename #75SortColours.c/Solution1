void sortColors(int* nums, int numsSize) { 
    
    int zerocount = 0; 
    int onecount = 0;
    int twocount = 0; 
    int k=0; 

    for (int i=0; i<numsSize; i++) { 
        if (nums[i]==0) { 
            zerocount++;
        }
        else if (nums[i]==1) { 
            onecount++;
        }
        else { 
            twocount++;
        }
    } 
    while (zerocount!=0) { 
        nums[k] = 0; 
        k++; 
        zerocount--;
    } 
    while (onecount!=0) { 
        nums[k] = 1; 
        k++; 
        onecount--;
    }
    while (twocount!=0) { 
        nums[k] = 2; 
        k++; 
        twocount--;
    }
    
}


