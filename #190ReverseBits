int reverseBits(int n) {  

    int r=0; 
    int rev =0; 

        for (int i=0; i<32; i++) {         
        r = n&1;   
        if (r==0) { 
            rev = rev << 1;   
        } 
        else { 
            rev = (rev << 1) + 1; 
        }
        n = n >> 1; 
    }     
    return rev;
    
} 
