int arrangeCoins(int n) { 

    int count=0;  
    int i=1;  

    if (n==0) { 
        return 0; 
    } 

    while (1) {  

        n = n - i; 

        count++;  

        if (n==0) { 

            return count; 
        } 
        else if (n<i+1) { 
            return count;  
        } 
        i++;
    } 
    return 0;
}
