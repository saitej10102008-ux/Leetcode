#include <stdio.h> 
#include <stdlib.h> 

int main (void) { 
    int n, r, sum=0, count=0; 
    printf("Enter n: "); 
    scanf("%d", &n); 

    while (n!=0) { 

        while (n!=0) { 
            r = n % 10; 
            sum = sum + r; 
            n = n / 10; 
            count++;
        } 

        if (count==1) { 
            printf("%d", sum); 
            exit(0);
        } 

        n = sum; 
        sum = 0;
        count=0;
    } 
    printf("%d", sum); 
    return 0; 
} 
