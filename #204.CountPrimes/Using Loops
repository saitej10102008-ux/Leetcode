#include <stdio.h>  
#include <math.h> 

int main (void) { 
    int n, count=0, k=0; 
    printf("enter n: "); 
    scanf("%d", &n); 

    for (int i=3; i<n; i++) { 
        for (int j=2; j<=sqrt(i); j++) { 
            if (i%j==0) { 
                count++; 

            }
 
        } 
        if (count==0) { 
            k++;
        }
        count=0; 

    }  

    if (n>=2) { 
        k = k+1; 
    } 
    printf("%d", k); 
    return 0; 
}
